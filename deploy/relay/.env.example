# Copy to .env on the relay host.
RELAY_DOMAIN=relay.example.org
# Same value as the app's RELAY_SECRET on Vercel. openssl rand -base64 48
RELAY_SECRET=
# The app's origin, e.g. https://aliquot.example.org (optional; empty allows any)
ALLOWED_ORIGINS=
# Relay image tag: "latest" (the newest build of main), or a commit's short
# SHA to pin a version, e.g. RELAY_TAG=1cf2f26
RELAY_TAG=latest
