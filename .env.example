# Postgres. Hosted databases use TLS automatically; add ?sslmode=disable for a local one.
DATABASE_URL=postgres://user:password@host:5432/aliquot

# Signs participant tokens and admin sessions. At least 32 random characters: openssl rand -base64 48
APP_SECRET=

# The address people open the app at. Admin passkeys are bound to its hostname.
# Leave empty in development to use whichever address the browser used.
APP_ORIGIN=

# Realtime relay (realtime/). Leave all three empty to run without it; screens then poll.
# RELAY_SECRET must match the relay's own RELAY_SECRET.
RELAY_PUBLIC_URL=wss://relay.example.org
RELAY_INTERNAL_URL=https://relay.example.org
RELAY_SECRET=
